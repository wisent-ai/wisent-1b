{
  "vocab_size": 256,
  "max_position_embeddings": 128,
  "d_model": 128,
  "n_layers": 4,
  "n_heads": 4,
  "d_head": 32,
  "intermediate_size": 352,
  "dropout": 0.0,
  "n_concepts": 8,
  "d_concept": 64,
  "concept_heads": 2,
  "concept_intermediate_size": 256,
  "named_concepts": [
    "truthfulness",
    "refusal",
    "code_mode",
    "uncertainty"
  ],
  "carry_concept_state": false,
  "layer_norm_eps": 1e-05,
  "initializer_range": 0.02,
  "tie_word_embeddings": false,
  "subspace_rank": 4,
  "normalize_subspace_basis": true,
  "probabilistic_concepts": true,
  "concept_log_std_init_range": 0.01,
  "kl_weight": 0.0001,
  "concept_mlp_hidden": 256,
  "use_concept_router": true,
  "use_manifold_decoder": true,
  "allowed_controls": {
    "magnitude": true,
    "direction": true,
    "uncertainty": true,
    "select": true
  },
  "use_concept_alignment": true,
  "alignment_weight": 1.0,
  "use_titan_manifold": true,
  "n_titan_directions": 4,
  "steering_hidden": 128,
  "use_geometry_regularization": true,
  "geometry_weight": 0.001,
  "use_language_invariant_concepts": false,
  "language_invariant_weight": 1.0
}
